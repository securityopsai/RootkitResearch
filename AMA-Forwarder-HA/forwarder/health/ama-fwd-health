#!/usr/bin/env bash
# ama-fwd-health - can this node receive syslog and hand it to Azure Monitor Agent?
#
# Usage:
#   ama-fwd-health [receive|forward|all] [--http]
#
#   receive  rsyslog is up and listening, disk has room, node not in maintenance.
#            A node failing this must not own a VIP (keepalived: hard fail).
#   forward  azuremonitoragent is up and listening for rsyslog.
#            keepalived uses this as a *weighted* check so that if AMA is down on
#            BOTH nodes (e.g. simultaneous extension upgrade) the VIPs stay put
#            and rsyslog keeps queueing, instead of both nodes dropping the VIPs.
#   all      both (default). Used for load balancer HTTP probes.
#
#   --http   answer one HTTP/1.0 request on stdin/stdout (systemd socket
#            activation): 200 when healthy, 503 otherwise. Azure LB treats any
#            status other than 200 as down.
#
# Exit status: 0 healthy, 1 unhealthy. The reason is printed on stdout.
#
# Deliberately NOT checked: Azure reachability or AMA upload backlog. A WAN or
# Azure outage affects every node at once; failing the probe then would take
# the whole pool down (Azure LB stops new flows and terminates UDP flows when
# all probes are down). Alert on backlog instead - see README "Monitoring".

set -u
export LC_ALL=C

CONF=${AMA_FWD_HEALTH_CONF:-/etc/ama-fwd/health.conf}

# Defaults - override in $CONF (sourced as shell).
LISTEN_PORT=514
CHECK_UDP=1
EXTRA_TCP_PORTS="2514"      # other listeners that must be up (RELP; add 6514 for TLS)
SPOOL_FS=/var
MIN_FREE_PCT=10
MAINT_FLAG=/etc/ama-fwd/maintenance
AMA_PORT_FILE=/etc/opt/microsoft/azuremonitoragent/config-cache/syslog.port
AMA_DEFAULT_PORT=28330

# shellcheck source=/dev/null
[ -r "$CONF" ] && . "$CONF"

listening() { # proto(t|u) port
    ss -Hln"$1" "sport = :$2" 2>/dev/null | grep -q .
}

check_receive() {
    if [ -e "$MAINT_FLAG" ]; then
        echo "maintenance flag $MAINT_FLAG present"; return 1
    fi
    if ! systemctl is-active --quiet rsyslog; then
        echo "rsyslog.service not active"; return 1
    fi
    if ! listening t "$LISTEN_PORT"; then
        echo "nothing listening on tcp/$LISTEN_PORT"; return 1
    fi
    if [ "$CHECK_UDP" = 1 ] && ! listening u "$LISTEN_PORT"; then
        echo "nothing listening on udp/$LISTEN_PORT"; return 1
    fi
    local port
    for port in $EXTRA_TCP_PORTS; do
        if ! listening t "$port"; then
            echo "nothing listening on tcp/$port"; return 1
        fi
    done
    local used
    used=$(df -P "$SPOOL_FS" 2>/dev/null | awk 'NR == 2 { sub("%", "", $5); print $5 }')
    if [ -z "$used" ] || [ $((100 - used)) -lt "$MIN_FREE_PCT" ]; then
        echo "$SPOOL_FS has less than $MIN_FREE_PCT% free (used: ${used:-unknown}%)"; return 1
    fi
}

check_forward() {
    if ! systemctl is-active --quiet azuremonitoragent; then
        echo "azuremonitoragent.service not active"; return 1
    fi
    # AMA >= 1.28.11 listens on tcp/28330, but picks a random port if that one
    # is taken (Linux 1.32.6+), so read the port AMA actually chose.
    local ama_port
    ama_port=$(tr -dc '0-9' 2>/dev/null < "$AMA_PORT_FILE")
    ama_port=${ama_port:-$AMA_DEFAULT_PORT}
    if ! listening t "$ama_port"; then
        echo "azuremonitoragent not listening on tcp/$ama_port"; return 1
    fi
}

check() {
    case "$1" in
        receive) check_receive ;;
        forward) check_forward ;;
        all)     check_receive && check_forward ;;
        *)       echo "unknown mode '$1'"; return 1 ;;
    esac && echo "ok"
}

mode=all
http=0
for arg in "$@"; do
    case "$arg" in
        receive|forward|all) mode=$arg ;;
        --http) http=1 ;;
        *) echo "usage: $0 [receive|forward|all] [--http]" >&2; exit 2 ;;
    esac
done

if [ "$http" = 1 ]; then
    # Drain the request head; don't hang on a client that never finishes it.
    while IFS= read -r -t 2 line; do
        line=${line%$'\r'}
        [ -z "$line" ] && break
    done
    if reason=$(check "$mode"); then status="200 OK"; else status="503 Service Unavailable"; fi
    body="$reason"$'\n'
    printf 'HTTP/1.0 %s\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n%s' \
        "$status" "${#body}" "$body"
    exit 0
fi

reason=$(check "$mode")
rc=$?
echo "$reason"
exit "$rc"
